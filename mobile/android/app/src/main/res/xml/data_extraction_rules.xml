<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The quote cache is re-fetchable, so it is not backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_flutter/quotes_cache.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_flutter/quotes_cache.json" />
    </device-transfer>
</data-extraction-rules>
